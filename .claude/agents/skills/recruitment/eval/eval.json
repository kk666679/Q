        { "old": "fresh graduate only", "alternative": "entry-level, training provided" },
        { "old": "male/female preferred", "alternative": "remove gender reference" },
        { "old": "must be Chinese/Indian/Malay", "alternative": "remove ethnicity reference" }
      ]
