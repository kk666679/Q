  "knowledge_base": {
    "regulations": {
      "employment_act_1955": {
        "sections": {
          "s10_probation": {
            "standard_period_days": 90,
            "maximum_period_days": 180,
            "maximum_with_justification_days": 365,
            "notice_requirement": "written",
            "extension_requires_consent": true
          },
          "s60l_discrimination": {
            "prohibited_bases": ["age", "race", "religion", "gender", "marital_status", "disability"],
            "penalty_max_myr": 10000,
            "examples_forbidden": [
              "young and energetic",
              "fresh graduate only",
              "male/female preferred",
              "must be Chinese/Indian/Malay"
            ]
          }
        }
      },
      "pdpa_2010": {
        "consent_required": true,
        "retention_limit_months": 12,
        "data_minimization": true,
        "access_right": true,
        "correction_right": true,
        "maximum_fine_myr": 1000000,
        "cross_border_restrictions": true
      },
      "myfuturejobs_act_2021": {
        "mandatory_for_salary_above_myr": 5000,
        "posting_days_required": 30,
        "applicable_before_foreign_hire": true,
        "retention_period_years": 2,
        "exemptions": ["government_contracts_under_6_months", "internal_transfers"]
