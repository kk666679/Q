          { "name": "opening", "duration_minutes": 10, "activities": ["role_overview", "company_intro", "interviewer_introductions"] },
          { "name": "technical_assessment", "duration_minutes": 20, "activities": ["skills_demo", "case_study", "portfolio_review"] },
          { "name": "behavioural_star", "duration_minutes": 20, "activities": ["situation", "task", "action", "result"] },
          { "name": "cultural_fit", "duration_minutes": 5, "activities": ["values_alignment", "team_dynamics"] },
          { "name": "candidate_qa", "duration_minutes": 5, "activities": ["answer_candidate_questions"] }
        ]
      },
      "offer": {
        "duration_days_min": 2,
        "duration_days_max": 3,
        "acceptance_deadline_days": 7,
        "negotiation_rounds_max": 2
      },
      "onboarding": {
        "duration_days_min": 5,
        "duration_days_max": 7,
        "pre_onboarding_days_before_start": 14
      }
