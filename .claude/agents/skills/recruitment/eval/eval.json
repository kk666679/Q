    "interview_assessment_rubric": {
      "criteria": [
        { "name": "technical_skills", "weight": 30, "poor_description": "missing key requirements", "good_description": "meets most requirements", "excellent_description": "exceeds requirements" },
        { "name": "communication", "weight": 20, "poor_description": "unclear, poor English", "good_description": "clear, good English", "excellent_description": "exceptional clarity" },
        { "name": "cultural_fit", "weight": 20, "poor_description": "misaligned with values", "good_description": "generally aligned", "excellent_description": "strong alignment" },
        { "name": "experience", "weight": 15, "poor_description": "less than required", "good_description": "meets requirement", "excellent_description": "exceeds requirement" },
        { "name": "potential", "weight": 15, "poor_description": "limited growth", "good_description": "good growth trajectory", "excellent_description": "high potential" }
      ],
      "scoring": {
        "1_poor": 1.0,
        "2_below_average": 2.0,
        "3_good": 3.0,
        "4_very_good": 4.0,
        "5_excellent": 5.0
