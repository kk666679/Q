        "anomaly_detection": {
          "critical": [
            { "condition": "netSalary < 0", "action": "block_payroll" },
            { "condition": "epfEmployee = 0 for eligible employee", "action": "block_payroll" },
            { "condition": "socsoEmployee = 0 for eligible employee", "action": "block_payroll" },
            { "condition": "duplicate run for same employee/period", "action": "block_payroll" }
