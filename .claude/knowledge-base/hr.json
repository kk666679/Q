    "common_errors_and_resolutions": {
      "epf_mismatch": {
        "error": "Employee EPF deduction does not match statutory rate",
        "root_cause": "Manual calculation error or wrong rate applied",
        "resolution": "Use Decimal.js for precision, reference current rates from knowledge base",
        "prevention": "Automated EPF calculation in payroll agent"
      },
      "visa_expired": {
        "error": "Foreign worker visa expired without renewal",
        "root_cause": "No expiry tracking or alert system",
        "resolution": "Submit urgent renewal, document root cause in CAPA",
        "prevention": "30/60/90-day automated alerts, calendar integration"
      },
      "incomplete_profile": {
        "error": "Employee record missing required fields",
        "root_cause": "Onboarding process gap",
        "resolution": "Run data completeness report, update missing fields",
        "prevention": "Enforce mandatory fields at onboarding"
      },
      "payroll_late": {
        "error": "Payroll submitted after statutory deadline",
        "root_cause": "No cutoff calendar or approval delays",
        "resolution": "Process immediately, pay penalties if incurred",
        "prevention": "Automated cutoff reminders, approval workflows"
      },
      "document_expired": {
        "error": "Supporting document expired and not renewed",
        "root_cause": "No ownership for renewal tracking",
        "resolution": "Assign document owner, submit renewal",
        "prevention": "Document expiry dashboard, renewal workflows"
      }
