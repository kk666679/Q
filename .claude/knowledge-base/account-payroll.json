    "internal_controls": {
      "segregation_of_duties": {
        "payroll_preparation": {
          "role": "Payroll Officer",
          "responsibilities": ["Data entry", "Calculation", "Generate payslips"],
          "cannot": ["Approve payroll", "Release payments", "Update bank account details"]
        },
        "payroll_approval": {
          "role": "Payroll Manager / HR Manager",
          "responsibilities": ["Verify calculations", "Review anomalies", "Authorize payment"],
          "cannot": ["Enter payroll data", "Modify bank account details"]
        },
        "payment_release": {
          "role": "Finance Manager",
          "responsibilities": ["Release bank transfers", "Sign statutory forms"],
          "cannot": ["Modify payroll calculations", "Approve payroll without review"]
        },
        "statutory_submission": {
          "role": "Compliance Officer / Finance",
          "responsibilities": ["Submit EPF/SOCSO/PCB", "Track deadlines", "Keep submission proofs"],
          "cannot": ["Modify payroll calculations", "Approve payroll without reconciliation"]
        }
      },
      "approval_matrices": {
        "payroll_run_approval": {
          "thresholds": [
            { "total_payroll_myr": "0 - 50,000", "approvers_required": 1, "min_level": "Payroll Manager" },
            { "total_payroll_myr": "50,001 - 250,000", "approvers_required": 2, "min_level": "HR Manager + Finance Manager" },
            { "total_payroll_myr": "250,001+", "approvers_required": 2, "min_level": "HR Director + Finance Director" }
          ]
        },
        "salary_change_approval": {
