    "reconciliation_procedures": {
      "monthly_payroll_reconciliation": {
        "steps": [
          {
            "step": 1,
            "action": "Verify gross payroll total matches sum of individual employee gross",
            "formula": "SUM(basicSalary + allowances + overtime + bonus) = PayrollRegister.total",
            "frequency": "Monthly"
          },
          {
            "step": 2,
            "action": "Validate EPF contributions against statutory rates",
            "formula": "SUM(employeeEPF) = SUM(basicSalary capped at 5500 × 0.11)",
            "frequency": "Monthly"
          },
          {
            "step": 3,
            "action": "Validate SOCSO contributions against wage ceiling",
            "formula": "SUM(employeeSOCSO) = SUM(wage capped at 6000 × 0.01)",
            "frequency": "Monthly"
          },
          {
            "step": 4,
            "action": "Reconcile net payroll with bank transfer total",
            "formula": "SUM(netSalary) = Bank Transfer Amount",
            "frequency": "Monthly"
          },
          {
            "step": 5,
            "action": "Reconcile statutory payable accounts with submissions",
            "formula": "Payable Balance = Sum of submitted payments this month",
            "frequency": "Monthly"
          },
          {
            "step": 6,
            "action": "Verify employee count matches active headcount",
            "formula": "Payroll Employee Count = Active Employee Count (excluding unpaid leave)",
            "frequency": "Monthly"
          }
        ],
        "variance_threshold_percent": 0.01,
        "investigation_required_above_percent": 0.5
      },
      "statutory_reconciliation": {
        "epf": {
          "reconciliation_frequency": "Monthly",
          "source_documents": ["Form A (e-Caruman)", "Payroll Register", "Bank Statement"],
          "key_checks": [
            "Total contribution matches payroll calculation",
            "Submission date ≤ 15th of following month",
            "Payment amount matches Form A total"
          ],
          "common_discrepancies": [
            { "issue": "Employee EPF calculated on uncapped wage", "resolution": "Apply RM 5,500 cap before calculation" },
            { "issue": "Foreign worker EPF incorrectly deducted", "resolution": "Verify EPF election status" },
            { "issue": "Late submission penalty incurred", "resolution": "Implement automated deadline reminders" }
          ]
        },
        "socso": {
          "reconciliation_frequency": "Monthly",
          "source_documents": ["Form 8A/9A", "Payroll Register", "Bank Statement"],
          "key_checks": [
            "Total contribution matches payroll calculation",
            "Submission date ≤ 15th of following month",
            "Wage ceiling RM 6,000 applied correctly"
          ],
          "common_discrepancies": [
            { "issue": "Wage ceiling not applied", "resolution": "Cap wage at RM 6,000 before SOCSO calculation" },
            { "issue": "Foreign worker SOCSO omitted", "resolution": "SOCSO mandatory for all foreign workers" }
          ]
        },
        "pcb": {
          "reconciliation_frequency": "Monthly",
          "source_documents": ["CP39 Form", "Payroll Register", "Tax Calculation Sheet"],
          "key_checks": [
            "PCB calculation matches tax brackets",
            "Submission date ≤ 10th of following month",
            "Non-resident rate 30% applied correctly"
          ],
          "common_discrepancies": [
            { "issue": "Resident status incorrectly classified", "resolution": "Verify days in Malaysia (>182 days for resident)" },
            { "issue": "Bonus PCB not calculated separately", "resolution": "Use average method for bonus PCB" }
          ]
        }
      },
      "year_end_reconciliation": {
        "activities": [
          {
            "activity": "EA Form Preparation",
            "deadline": "March 31",
            "checks": [
