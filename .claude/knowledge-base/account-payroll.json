            { "change_percent": "5 - 15", "approvers_required": 2, "min_level": "Department Head + HR Manager" },
            { "change_percent": "15+", "approvers_required": 2, "min_level": "HR Director + GM" }
          ]
        },
        "bonus_approval": {
          "thresholds": [
            { "bonus_months": "0 - 1", "approvers_required": 1, "min_level": "HR Manager" },
            { "bonus_months": "1 - 3", "approvers_required": 2, "min_level": "HR Director + Finance Director" },
            { "bonus_months": "3+", "approvers_required": 3, "min_level": "CEO + HR Director + Finance Director" }
          ]
        }
      },
      "audit_trail_requirements": {
        "payroll_changes": {
          "tracked_fields": ["basicSalary", "allowances", "bankAccount", "department", "position"],
          "retention_months": 84,
          "required_metadata": ["userId", "timestamp", "oldValue", "newValue", "reason"]
        },
        "payroll_approvals": {
          "tracked_actions": ["submitted", "approved", "rejected", "paid"],
          "retention_months": 84,
          "required_metadata": ["approverId", "timestamp", "status", "comments"]
        },
        "statutory_submissions": {
          "tracked_actions": ["generated", "submitted", "paid", "confirmed"],
          "retention_years": 7,
          "required_metadata": ["submittedBy", "timestamp", "submissionId", "authorityReference"]
        }
      }
    },
    "common_accounting_errors": {
      "error_001": {
        "name": "EPF Calculated on Gross Without Cap",
        "description": "Employee EPF deducted on full gross salary exceeding RM 5,500",
        "impact": "Overstated EPF expense and liability",
        "detection": "Compare EPF deduction with (basicSalary capped at 5500 × 0.11)",
        "correction": "Reverse incorrect entry, post correct EPF amounts",
        "prevention": "Apply MIN(basicSalary, 5500) in EPF calculation logic"
      },
      "error_002": {
        "name": "SOCSO Wage Ceiling Not Applied",
        "description": "SOCSO calculated on full wage above RM 6,000",
        "impact": "Overstated SOCSO expense and liability",
        "detection": "Check if any employee wage > 6000 and SOCSO = wage × 0.01",
        "correction": "Reverse entry, recalculate with ceiling RM 6,000",
        "prevention": "Apply MIN(wage, 6000) in SOCSO calculation logic"
      },
      "error_003": {
        "name": "Foreign Worker Levy Expensed Incorrectly",
        "description": "Levy charged to employee instead of employer",
        "impact": "Understated employer expense, incorrect employee deduction",
        "detection": "Verify levy deduction in employee payslip",
        "correction": "Remove levy from employee deduction, record as employer expense",
        "prevention": "Configure levy as employer-borne in payroll system"
      },
      "error_004": {
        "name": "PCB Rate Applied to Wrong Resident Status",
        "description": "Resident tax brackets used for non-resident employee",
        "impact": "Understated PCB, penalty risk from LHDN",
        "detection": "Check days in Malaysia for foreign workers (>182 days = resident)",
        "correction": "Adjust PCB calculation, submit additional payment if needed",
        "prevention": "Track employee entry/exit dates, apply correct resident status"
      },
      "error_005": {
        "name": "Decimal Precision Loss in Monetary Values",
        "description": "Using JavaScript number/float instead of Decimal for MYR",
        "impact": "Rounding errors, balance sheet discrepancies",
        "detection": "Sum of employee net pay ≠ total bank transfer",
        "correction": "Convert all monetary fields to Decimal type",
        "prevention": "Enforce Decimal type in Prisma schema for all monetary fields"
      },
      "error_006": {
        "name": "Duplicate Payroll Run",
        "description": "Same employee and period processed twice",
        "impact": "Overstated expenses, duplicate payments",
        "detection": "Check for duplicate employeeId + periodEnd in payroll table",
        "correction": "Reverse second run, recover overpayment if paid",
        "prevention": "Implement uniqueness constraint on (employeeId, periodEnd)"
      }
    },
