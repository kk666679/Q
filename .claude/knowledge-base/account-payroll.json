    "journal_entry_templates": {
      "monthly_payroll_accrual": {
        "name": "Monthly Payroll Accrual",
        "timing": "Last day of month",
        "entries": [
          {
            "account": "6100",
            "account_name": "Salary Expense",
            "debit": "Gross Basic Salary",
            "credit": null,
            "calculation": "SUM(basicSalary)"
          },
          {
            "account": "6110",
            "account_name": "Allowance Expense",
            "debit": "Total Allowances",
            "credit": null,
            "calculation": "SUM(housing + transport + meal + childcare)"
          },
          {
            "account": "6120",
            "account_name": "Overtime Expense",
            "debit": "Overtime Pay",
            "credit": null,
            "calculation": "SUM(overtimeAmount)"
          },
          {
            "account": "6140",
            "account_name": "EPF Employer Expense",
            "debit": "Employer EPF",
            "credit": null,
            "calculation": "SUM(basicSalary × 0.13) [capped at RM 5,500 wage]"
          },
          {
            "account": "6150",
            "account_name": "SOCSO Employer Expense",
            "debit": "Employer SOCSO",
            "credit": null,
            "calculation": "SUM(wage × 0.0225) [capped at RM 6,000]"
          },
          {
            "account": "6160",
            "account_name": "EIS Employer Expense",
            "debit": "Employer EIS",
            "credit": null,
            "calculation": "SUM(wage × 0.002) [capped at RM 6,000]"
          },
          {
            "account": "2100",
            "account_name": "Salaries Payable",
            "debit": null,
            "credit": "Net Salary Payable",
            "calculation": "Gross - Employee Deductions"
          },
          {
            "account": "2110",
            "account_name": "EPF Payable",
            "debit": null,
            "credit": "Total EPF (Employee + Employer)",
            "calculation": "SUM(epfEmployee + epfEmployer)"
          },
          {
            "account": "2120",
            "account_name": "SOCSO Payable",
            "debit": null,
            "credit": "Total SOCSO (Employee + Employer)",
            "calculation": "SUM(socsoEmployee + socsoEmployer)"
          },
          {
            "account": "2130",
            "account_name": "EIS Payable",
            "debit": null,
            "credit": "Total EIS (Employee + Employer)",
            "calculation": "SUM(eisEmployee + eisEmployer)"
          },
          {
            "account": "2140",
            "account_name": "PCB Payable",
            "debit": null,
            "credit": "Total PCB",
            "calculation": "SUM(pcb)"
          }
        ],
        "example": {
          "gross_salary": 50000,
          "net_salary": 42000,
          "epf_total": 6500,
          "socso_total": 1125,
          "eis_total": 100,
          "pcb_total": 275,
          "journal": "Dr Salary & Benefits Expense RM 57,725, Cr Liabilities RM 57,725"
        }
      },
      "payroll_payment": {
        "name": "Payroll Settlement",
        "timing": "5th of month (or earlier)",
        "entries": [
          {
            "account": "2100",
            "account_name": "Salaries Payable",
            "debit": "Net Salary Payable",
            "credit": null,
            "description": "Clear salary liability"
          },
          {
            "account": "Bank Account",
            "account_name": "Cash at Bank",
            "debit": null,
            "credit": "Net Salary Payable",
            "description": "Bank transfer to employees"
          }
        ],
        "example": "Dr Salaries Payable RM 42,000, Cr Bank RM 42,000"
      },
      "statutory_submission": {
        "name": "Statutory Payment to Authorities",
        "timing": "By 10th (PCB) or 15th (EPF/SOCSO/EIS)",
        "entries": [
          {
            "account": "2110",
            "account_name": "EPF Payable",
            "debit": "Total EPF Due",
            "credit": null,
            "description": "Clear EPF liability"
          },
          {
            "account": "2120",
            "account_name": "SOCSO Payable",
            "debit": "Total SOCSO Due",
            "credit": null,
            "description": "Clear SOCSO liability"
          },
          {
            "account": "2130",
            "account_name": "EIS Payable",
            "debit": "Total EIS Due",
            "credit": null,
            "description": "Clear EIS liability"
          },
          {
            "account": "2140",
            "account_name": "PCB Payable",
            "debit": "Total PCB Due",
            "credit": null,
            "description": "Clear PCB liability"
          },
          {
            "account": "Bank Account",
            "account_name": "Cash at Bank",
            "debit": null,
            "credit": "Total Statutory Payment",
            "description": "Payment to authorities"
          }
        ],
        "example": "Dr EPF Payable RM 6,500, Dr SOCSO Payable RM 1,125, Cr Bank RM 7,625"
      },
      "foreign_worker_levy": {
        "name": "Foreign Worker Levy Accrual and Payment",
        "timing": "Upon visa renewal (annual)",
        "entries": [
          {
            "account": "6170",
            "account_name": "Foreign Worker Levy Expense",
            "debit": "Levy Amount by Sector",
            "credit": null,
            "calculation": "Sector rate × number of workers"
          },
          {
            "account": "2150",
            "account_name": "Levy Payable",
            "debit": null,
            "credit": "Levy Amount",
            "description": "Accrue levy liability"
          },
          {
            "account": "2150",
            "account_name": "Levy Payable",
            "debit": "Levy Amount",
            "credit": null,
            "description": "Clear liability upon payment"
          },
          {
            "account": "Bank Account",
            "account_name": "Cash at Bank",
            "debit": null,
            "credit": "Levy Amount",
            "description": "Payment to Immigration/MYEG"
          }
        ],
        "example_by_sector": {
          "manufacturing": "Dr Levy Expense RM 1,850, Cr Levy Payable RM 1,850 per worker",
          "services": "Dr Levy Expense RM 1,850, Cr Levy Payable RM 1,850 per worker",
          "construction": "Dr Levy Expense RM 1,250, Cr Levy Payable RM 1,250 per worker"
