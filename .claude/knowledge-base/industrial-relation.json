    "legal_framework": {
      "employment_act_1955": {
        "scope": {
          "applicable_to": [
            "employees earning ≤ RM 2,000 monthly",
            "manual laborers regardless of salary",
            "operators of machinery",
            "supervisors of manual workers",
            "domestic servants"
          ],
          "excluded": [
            "managerial executives earning > RM 5,000",
            "seafarers",
            "domestic servants (partial exclusion)"
          ]
        },
        "key_provisions": {
          "s12_termination_benefits": {
            "title": "Termination and Lay-off Benefits",
            "entitlement": "10-20 days per year of service based on length",
            "calculation": "Last drawn wage × years of service × daily rate factor",
            "daily_rate_formula": "Monthly wage ÷ 26"
          },
          "s14_dismissal": {
            "title": "Dismissal Without Notice",
            "grounds": [
              "misconduct",
              "insubordination",
              "negligence",
              "breach of trust",
              "absenteeism",
              "criminal offense"
            ],
            "procedure": "domestic_inquiry_required",
            "notice": "immediate_termination_possible"
          },
          "s15_constructive_dismissal": {
            "title": "Constructive Dismissal",
            "definition": "Employee resigns due to employer's breach of contract",
            "examples": [
              "unilateral salary reduction",
              "demotion without cause",
              "hostile work environment",
              "fundamental change of duties"
            ],
            "employee_burden": "must prove fundamental breach"
          },
          "s60k_sexual_harassment": {
            "title": "Sexual Harassment",
            "employer_duty": "investigate and take disciplinary action",
            "penalty": "fine up to RM 10,000 or imprisonment"
          }
        }
      },
      "industrial_relations_act_1967": {
        "part_ix_unfair_dismissal": {
          "section_20": {
            "title": "Representation Against Dismissal",
            "time_limit_days": 60,
            "process": "DGIR → Conciliation → Industrial Court",
            "remedies": ["reinstatement", "compensation_back_wages", "compensation_in_lieu"],
            "back_wages_calculation": "from dismissal date to reinstatement date",
            "compensation_in_lieu_max_months": 24
          }
        },
        "trade_union_provisions": {
          "section_27_recognition": {
            "threshold_percent": 50,
            "application_process": "Form A to DGIR",
            "timeline_days": 30,
            "recognition_benefits": ["collective_bargaining", "represent_members", "access_to_workplace"]
          },
          "section_30_collective_bargaining": {
            "scope": ["wages", "allowances", "hours_of_work", "leave", "benefits"],
            "excluded": ["promotion", "transfer", "recruitment"],
            "collective_agreement_duration_years": 3,
            "negotiation_timeline_days": 60
          },
          "protected_activities": [
            "lawful picketing",
            "peaceful assembly",
            "strike (with notice)",
            "union membership solicitation"
          ],
          "prohibited_activities": [
            "secondary strike",
            "general strike",
            "strike during collective agreement term",
            "intimidation or violence"
          ]
        }
      },
      "child_act_2001": {
        "employment_restrictions": {
          "minimum_age": 15,
          "light_work_age_13_14": "parental_permission_required",
          "hazardous_work": "prohibited_under_18",
          "max_hours_per_week_under_16": 40
        }
      }
    },
    "disciplinary_procedures": {
      "progressive_discipline": {
        "stage_1_verbal_warning": {
          "trigger": "minor_infringement_first_offense",
          "process": "private_conversation",
          "documentation": "recorded_in_file",
          "validity_months": 6
        },
        "stage_2_written_warning": {
          "trigger": "repeated_minor_offenses",
          "process": "formal_letter",
          "documentation": "employee_acknowledgment_required",
          "validity_months": 12,
          "escalation": "next_violation_leads_to_show_cause"
        },
        "stage_3_show_cause_letter": {
          "trigger": "serious_misconduct_or_repeated_warnings",
          "process": "letter_with_allegations",
          "response_days": 7,
          "documentation": "employee_explanation_required"
        },
        "stage_4_domestic_inquiry": {
          "trigger": "unsatisfactory_explanation_or_serious_offense",
          "process": "formal_inquiry_with_charges",
          "documentation": "complete_transcript"
        },
        "stage_5_termination": {
          "trigger": "guilty_finding_at_inquiry",
          "process": "dismissal_letter",
          "documentation": "inquiry_report_attached"
        }
      },
      "domestic_inquiry": {
        "required_elements": [
          {
            "element": "show_cause_letter",
            "description": "Written notice of allegations",
            "deadline_days_before_inquiry": 14,
            "template_required_fields": ["allegations", "date_time_venue", "employee_rights", "consequences"]
          },
          {
            "element": "inquiry_panel",
            "description": "Neutral independent panel (min 3 members)",
            "composition": "management_representative + hr_representative + independent_rep",
            "qualifications": ["no_involvement_in_case", "trained_in_inquiry_process"]
          },
          {
            "element": "chargesheet",
            "description": "Specific, dated, particularized charges",
            "required": true,
            "format": "numbered_paragraphs_with_evidence_references"
          },
          {
            "element": "evidence",
            "description": "Witnesses, documents, exhibits",
            "standard": "balance_of_probabilities",
            "types": ["documentary", "physical", "testimonial", "expert"]
          },
          {
            "element": "employee_rights",
            "description": "Right to be heard, legal representation, cross-examine",
            "union_rep_allowed": true,
            "legal_counsel_allowed": true
          },
          {
            "element": "transcript",
            "description": "Complete verbatim record",
            "retention_years": 6,
            "format": "written_or_audio_recorded"
          },
          {
            "element": "findings_report",
            "description": "Written determination with reasoning",
            "submission_days_after_inquiry": 14,
            "required_sections": ["introduction", "charges", "evidence_summary", "findings", "recommendation"]
          }
        ],
        "inquiry_process_timeline": {
          "show_cause_issued": "day_0",
          "employee_response_due": "day_7",
          "inquiry_notice_issued": "day_10",
          "inquiry_hearing_days": "day_21_35",
          "findings_submitted": "day_49",
          "management_decision": "day_56",
          "appeal_deadline": "day_70"
        },
        "common_charges": {
          "misconduct": {
            "examples": [
              "theft_of_company_property",
              "insubordination",
              "falsification_of_records",
              "conflict_of_interest",
              "unauthorized_absence"
            ],
            "recommended_penalty": "dismissal_for_serious_cases",
            "evidence_needed": "clear_and_convincing"
          },
          "poor_performance": {
            "examples": [
              "consistent_missed_targets",
              "quality_deficiencies",
              "safety_violations"
            ],
            "recommended_penalty": "pip_before_dismissal",
            "evidence_needed": "performance_records_and_warnings"
          },
          "attendance": {
            "examples": [
              "chronic_lateness",
              "frequent_absenteeism",
              "no_show_no_call"
            ],
            "recommended_penalty": "warning_then_dismissal",
            "evidence_needed": "attendance_records_and_mc_certificates"
          }
        },
        "inquiry_checklist": {
          "pre_inquiry": [
            "show_cause_letter_issued_and_received",
            "employee_response_received",
            "panel_appointed_and_briefed",
            "venue_and_schedule_confirmed",
            "evidence_gathered_and_organized",
            "witnesses_confirmed"
          ],
          "during_inquiry": [
            "oath_taken_by_witnesses",
            "prosecutor_presents_case",
            "witnesses_examined_and_cross_examined",
            "employee_presents_defence",
            "all_parties_sign_transcript_daily"
          ],
          "post_inquiry": [
            "findings_report_drafted",
            "panel_deliberation_conducted",
            "management_review_completed",
            "decision_communicated_to_employee"
          ]
        }
      },
      "investigation_best_practices": {
        "steps": [
          { "step": 1, "action": "Receive complaint or identify issue", "timeline_hours": 24, "owner": "hr_receiving" },
          { "step": 2, "action": "Secure evidence (documents, CCTV, emails)", "timeline_hours": 48, "owner": "investigator" },
          { "step": 3, "action": "Interview complainant and witnesses", "timeline_hours": 72, "owner": "investigator" },
          { "step": 4, "action": "Interview accused employee", "timeline_hours": 96, "owner": "investigator" },
          { "step": 5, "action": "Prepare investigation report", "timeline_days": 7, "owner": "investigator" },
          { "step": 6, "action": "Recommend action to management", "timeline_days": 10, "owner": "hr_manager" }
        ],
        "documentation_requirements": [
          "witness_statements_signed",
          "evidence_log_with_chain_of_custody",
          "investigation_notes_dated",
          "final_report_with_findings_and_recommendations"
        ],
        "investigator_qualifications": [
          "trained_in_investigation_techniques",
          "impartial_and_uninvolved",
          "knowledgeable_about_relevant_policies",
          "good_interviewing_and_writing_skills"
        ]
