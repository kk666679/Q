# ⚠️  NEVER commit real credentials here.
# Copy this file to .env.local and fill in your values.
# This file is a template only — all values are placeholders.

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="<your-vercel-blob-token>"

# Database
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require"
POSTGRES_URL="postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require"
PRISMA_DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require"

# Vercel OIDC (injected automatically by Vercel CI — do not set manually)
# VERCEL_OIDC_TOKEN=

# QMS / Ollama Cloud
QMS="<your-qms-api-key>"

# Pinecone Vector Database
PINECONE_API_KEY="<your-pinecone-api-key>"
PINECONE_INDEX_NAME="qms-compliance"

# OpenAI (for embeddings and RAG)
OPENAI_API_KEY="<your-openai-api-key>"

# Auth
NEXTAUTH_SECRET="<generate-with: openssl rand -base64 32>"
NEXTAUTH_URL="http://localhost:3000"
